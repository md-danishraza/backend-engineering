{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext", // changed from ESNext
    "moduleResolution": "NodeNext", // changed from node
    "outDir": "./dist", // needed  build script
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
